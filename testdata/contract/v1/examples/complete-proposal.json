{
  "about": "Countersign completes a proposal with the owner's decision and a result. The result is optional, for proposals as for items.",
  "given": {
    "calls": [
      {
        "as": "conn",
        "method": "POST",
        "path": "/v1/edits",
        "body": {
          "contract": "v1",
          "target": "catalog.sample-calculator.description",
          "change": "The sample description should say which made-up rule it follows.",
          "reason": "It reads as if no rule applies.",
          "pow": "2026-01-05.208bd",
          "honeypot": "",
          "source": "203.0.113.7"
        }
      },
      {
        "as": "countersign",
        "method": "POST",
        "path": "/v1/lease",
        "body": {
          "contract": "v1"
        }
      }
    ]
  },
  "request": {
    "as": "countersign",
    "method": "POST",
    "path": "/v1/complete",
    "body": {
      "contract": "v1",
      "lease": "EP-0001.1.1",
      "state": "approved",
      "result": {
        "note": "made-up note from the owner"
      }
    }
  },
  "expect": {
    "status": 200,
    "body": {
      "id": "EP-0001",
      "state": "approved",
      "next": "bellbuoy"
    }
  }
}
