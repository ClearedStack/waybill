{
  "about": "Conn forwards a candidate a visitor sent through the form on the site, with its proof of work and the visitor's address.",
  "request": {
    "as": "conn",
    "method": "POST",
    "path": "/v1/items",
    "body": {
      "contract": "v1",
      "source": "site-form",
      "title": "A made-up tool a visitor asked for",
      "address": "https://example.org/made-up/asked-for-1",
      "pow": "2026-01-05.70b6f",
      "visitor": "203.0.113.7"
    }
  },
  "expect": {
    "status": 201,
    "body": {
      "id": "PA-0001",
      "state": "discovered",
      "next": "trawl"
    }
  }
}
