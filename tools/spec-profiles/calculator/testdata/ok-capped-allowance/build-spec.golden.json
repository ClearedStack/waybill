  "schema": {
    "tool_type": "calculator",
    "title": "prorated daily allowance with a cap",
    "inputs": [
      {
        "name": "days",
        "type": "number",
        "unit": "day",
        "min": 0,
        "max": 365
      },
      {
        "name": "daily_amount",
        "type": "number",
        "unit": "USD",
        "min": 0,
        "max": 1000
      },
      {
        "name": "cap",
        "type": "number",
        "unit": "USD",
        "min": 0,
        "max": 100000
      }
    ],
    "outputs": [
      {
        "name": "allowance",
        "type": "number",
        "unit": "USD",
        "formula": "min(days * daily_amount, cap)"
      }
    ]
  },
